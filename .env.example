# Sanity CMS (public — safe to expose, shipped to browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=rndr2995
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token (OPTIONAL — the site does not need one; leave it unset).
# The rndr2995 dataset is publicly readable, and Vercel deliberately has no
# token set. Only add one if you create a fresh Viewer token on rndr2995 — a
# token belonging to the old wg3ga4x6 project 401s on every read, which breaks
# the site more confusingly than having no token at all. Left commented out so
# copying this file does not send a placeholder token on every request.
# SANITY_API_TOKEN=

# Google Analytics 4 (optional — analytics are normally managed inside the CMS)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Canonical site URL (used for SEO canonical tags, OpenGraph, sitemap, robots)
NEXTAUTH_URL=https://www.kydongrp.com
